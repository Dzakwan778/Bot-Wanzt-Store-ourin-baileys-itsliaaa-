# Environment variables
# Optional initial bootstrap credentials when provisioning a brand-new database:
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=
# TENANT_BOOTSTRAP_USERNAME=
# TENANT_BOOTSTRAP_PASSWORD=
# LOCAL_AUTH_BOOTSTRAP_USERNAME=
# LOCAL_AUTH_BOOTSTRAP_PASSWORD=
# Allowed browser cross-origins (comma-separated, no trailing slash, never '*'):
# CORS_ORIGINS=https://testbot.wanma2.my.id,https://admin.wanma2.my.id
