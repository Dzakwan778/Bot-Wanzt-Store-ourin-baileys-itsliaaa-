# Salin file ini menjadi .env lalu isi sesuai domain dan kredensial server Anda
NODE_ENV=production
PORT=3000

# Allowed browser cross-origins (pisahkan dengan koma, tanpa slash di akhir, jangan isi '*')
CORS_ORIGINS=https://domainanda.com,https://admin.domainanda.com

# Kredensial bootstrap awal saat database masih kosong
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
TENANT_BOOTSTRAP_USERNAME=
TENANT_BOOTSTRAP_PASSWORD=

# Opsional: Kredensial bootstrap untuk mode local/standalone auth
LOCAL_AUTH_BOOTSTRAP_USERNAME=
LOCAL_AUTH_BOOTSTRAP_PASSWORD=
APARTMENT_ADMIN_BOOTSTRAP_USERNAME=
APARTMENT_ADMIN_BOOTSTRAP_PASSWORD=
